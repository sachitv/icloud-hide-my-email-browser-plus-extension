{
  "name": "icloud-hide-my-email-plus-browser-extension",
  "version": "1.5.3",
  "description": "Cross-browser extension bringing iCloud's Hide My Email service to more browsers as Hide My Email+.",
  "license": "MIT",
  "author": "Sachit Vithaldas",
  "repository": {
    "type": "git",
    "url": "https://github.com/sachitv/icloud-hide-my-email-browser-plus-extension.git"
  },
  "scripts": {
    "build:brave": "wxt build --browser=brave",
    "build:chrome": "wxt build --browser=chrome",
    "build:edge": "wxt build --browser=edge",
    "//build:e2e": "Chrome build with demo mode compiled in, for the Playwright suite only. Never publish this output.",
    "build:e2e": "wxt build --browser=chrome --mode e2e",
    "build:firefox": "wxt build --browser=firefox",
    "build": "wxt build --browser=brave",
    "check:licenses": "node utils/checkLicenses.mjs",
    "check:release-build": "node utils/checkReleaseBuild.mjs",
    "dev": "wxt",
    "biome:format": "biome format --write .",
    "biome:format:check": "biome format",
    "lint:check": "biome lint",
    "lint": "biome lint --write .",
    "prettier:check": "prettier --check '**/*.{scss,md}'",
    "prettier": "prettier --write '**/*.{scss,md}'",
    "package:brave": "wxt zip --browser=brave",
    "package:chrome": "wxt zip --browser=chrome",
    "package:edge": "wxt zip --browser=edge",
    "package:firefox": "wxt zip --browser=firefox",
    "package:sources": "wxt zip --sources",
    "package": "wxt zip --browser=brave",
    "postinstall": "wxt prepare",
    "prebuild:firefox": "rm -rf build",
    "prebuild": "rm -rf build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:e2e && playwright test",
    "publish": "publish-extension",
    "report:licenses": "node utils/generateLicenseTable.mjs > ATTRIBUTIONS.md && npx prettier --write ATTRIBUTIONS.md",
    "start:brave": "wxt --browser=brave",
    "start:chrome": "wxt --browser=chrome",
    "start:edge": "wxt --browser=edge",
    "//": "Dev mode does not support Firefox MV3, so we debug in MV2 mode instead.",
    "start:firefox": "wxt --browser=firefox --mv2",
    "start": "wxt --browser=brave --debug",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "fuse.js": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "^1.62.1",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.9.0",
    "jsdom": "^28.1.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "postcss": "^8.5.24",
    "prettier": "^3.8.1",
    "publish-browser-extension": "^6.1.1",
    "spdx-expression-parse": "^4.0.0",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vitest": "^4.0.7",
    "web-ext": "^10.5.0",
    "wxt": "^0.20.27"
  },
  "overrides": {
    "shell-quote": "1.9.0",
    "tmp": ">=0.2.6",
    "esbuild": ">=0.28.1",
    "nanoid": "3.3.17",
    "adm-zip": "0.6.0",
    "node-notifier": {
      "uuid": ">=11.1.1"
    }
  }
}
